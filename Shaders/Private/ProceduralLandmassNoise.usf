/**
 * ProceduralLandmassNoise Compute Shader — GPU fBm Perlin Noise Map Generation
 *
 * Mirror of UProceduralLandmassBPLibrary::GenerateNoiseMap but executed on GPU
 * via Compute Shader. Outputs a normalized [0,1] noise value per pixel to a
 * RWTexture2D<float> UAV (backed by PF_R32_FLOAT RenderTarget on the CPU side).
 *
 * Algorithm: fractal Brownian motion (fBm) of 2D Perlin (gradient) noise.
 * Octave offsets are derived deterministically from Seed so no CPU-side
 * pre-computation is needed beyond the scalar parameters listed below.
 */

#include "/Engine/Public/Platform.ush"

// ── Inputs (bound via SHADER_PARAMETER_STRUCT in C++) ──────────────────────

int   ChunkSize;
float Scale;
int   Octaves;
float Persistence;
float Lacunarity;
int   Seed;
float2 Offset;

// ── Output UAV ─────────────────────────────────────────────────────────────

RWTexture2D<float> RenderTarget;

// ── Terrain-type color lookup ───────────────────────────────────────────────

struct FTerrainTypeGPU
{
	float  NoiseHeight;   // offset 0
	float  _Padding0;     // offset 4  — explicit padding to match C++ FTerrainTypeGPU layout
	float  _Padding1;     // offset 8
	float  _Padding2;     // offset 12
	float4 Color;         // offset 16
};

StructuredBuffer<FTerrainTypeGPU> TerrainTypes;
int  NumTerrainTypes;
RWTexture2D<float4> ColorRenderTarget;  // RGBA8 颜色输出

// ── Thread-group size (set via ModifyCompilationEnvironment) ────────────────

#ifndef THREADGROUPSIZE_X
#define THREADGROUPSIZE_X 8
#endif
#ifndef THREADGROUPSIZE_Y
#define THREADGROUPSIZE_Y 8
#endif

// ═══════════════════════════════════════════════════════════════════════════
//  Hash / random helpers
// ═══════════════════════════════════════════════════════════════════════════

/** Deterministic 2D → 2D hash. Returns both components in [0,1). */
float2 Hash2D(float2 p)
{
	p = float2(dot(p, float2(127.1, 311.7)),
	           dot(p, float2(269.5, 183.3)));
	return frac(sin(p) * 43758.5453);
}

// ═══════════════════════════════════════════════════════════════════════════
//  2D Perlin noise (gradient noise)
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Classic Perlin noise.
 * @param p  input coordinate
 * @return   noise value approximately in [-1, 1]
 */
float PerlinNoise2D(float2 p)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float2 u = f * f * (3.0 - 2.0 * f);   // smoothstep

	// Gradient vectors at the 4 surrounding corners
	float2 a = Hash2D(i)                     * 2.0 - 1.0;
	float2 b = Hash2D(i + float2(1.0, 0.0)) * 2.0 - 1.0;
	float2 c = Hash2D(i + float2(0.0, 1.0)) * 2.0 - 1.0;
	float2 d = Hash2D(i + float2(1.0, 1.0)) * 2.0 - 1.0;

	// Dot products → bilinear interpolation
	float da = dot(a, f);
	float db = dot(b, f - float2(1.0, 0.0));
	float dc = dot(c, f - float2(0.0, 1.0));
	float dd = dot(d, f - float2(1.0, 1.0));

	return lerp(lerp(da, db, u.x), lerp(dc, dd, u.x), u.y);
}

// ═══════════════════════════════════════════════════════════════════════════
//  fBm (fractal Brownian motion)
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Multi-octave fBm with Perlin noise.
 * Normalization uses the theoretical min/max so adjacent chunks tile correctly.
 *
 * @param p            base coordinate (already divided by Scale, with Offset applied)
 * @param octaves      number of octaves
 * @param persistence  amplitude multiplier each octave
 * @param lacunarity   frequency multiplier each octave
 * @return             noise value approximately in [-1, 1]
 */
float fBm(float2 p, int octaves, float persistence, float lacunarity)
{
	float value    = 0.0;
	float amplitude = 1.0;
	float frequency = 1.0;
	float maxValue  = 0.0;

	for (int i = 0; i < 16; i++)   // 16 = reasonable upper bound; 'octaves' controls early-out
	{
		if (i >= octaves) break;

		// Deterministic octave offset derived from Seed (mimics CPU's RandInit)
		float2 octOffset = Hash2D(float2(float(Seed + i * 127), float(Seed - i * 311)))
		                   * 200000.0 - 100000.0;

		float2 samplePos = p * frequency + octOffset;
		value    += PerlinNoise2D(samplePos) * amplitude;
		maxValue += amplitude;
		amplitude *= persistence;
		frequency *= lacunarity;
	}

	// Normalize by theoretical max amplitude sum (CPU equivalent: / theoreticalMax)
	return value / max(maxValue, 0.0001);
}

// ═══════════════════════════════════════════════════════════════════════════
//  Main entry point
// ═══════════════════════════════════════════════════════════════════════════

[numthreads(THREADGROUPSIZE_X, THREADGROUPSIZE_Y, 1)]
void MainComputeShader(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int x = DispatchThreadId.x;
	int y = DispatchThreadId.y;

	if (x >= ChunkSize || y >= ChunkSize)
		return;

	float halfSize = float(ChunkSize) * 0.5;

	// Base coordinate = world-space position of this pixel
	float2 p;
	p.x = (float(x) - halfSize + Offset.x) / max(Scale, 0.0001);
	p.y = (float(y) - halfSize + Offset.y) / max(Scale, 0.0001);

	float noise = fBm(p, Octaves, Persistence, Lacunarity);

	// ── 对比度补偿：把 fBm 的实际范围拉伸回 [0,1] ─────────────────
	// fBm 归一化后实际只分布在 ±0.3 附近（单倍频 Perlin 经验范围
	// 约 ±0.5~0.8，远小于理论 ±1），直接 (noise+1)*0.5 只会落在
	// [0.35,0.68] 一带。乘上增益后用 smoothstep 软钳位铺满 [0,1]。
	// 增益按 Scale 调整：Scale 大用小值（2~3），Scale 小用大值（3~4）。
	float normalized = smoothstep(-1.0, 1.0, noise * 3.0);

	// Color lookup from terrain types (threshold-based, first-match wins)
	float4 outColor = float4(0.0, 0.0, 0.0, 1.0);
	for (int i = 0; i < NumTerrainTypes; i++)
	{
		if (normalized <= TerrainTypes[i].NoiseHeight)
		{
			outColor = TerrainTypes[i].Color;
			break;
		}
	}
	ColorRenderTarget[uint2(x, y)] = outColor;
	RenderTarget[uint2(x, y)] = normalized;
}
